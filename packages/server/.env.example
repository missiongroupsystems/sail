# Copy to .env for a real database. For a zero-setup local run use `pnpm dev:local` instead.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Supabase Postgres: transaction pooler (6543) for requests, session connection (5432) for LISTEN and migrations.
DATABASE_URL=postgres://postgres.<project>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
LISTEN_DATABASE_URL=postgres://postgres.<project>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10
TX_MAX=6
QUEUE_MAX=64

CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Back-office sign-in. By default people sign in with email and password (the local identity provider), and sessions
# are signed with SESSION_TOKEN_SECRET. Setting SUPABASE_URL (JWKS) and/or SUPABASE_JWT_SECRET switches to an
# external OIDC issuer instead.
SESSION_TOKEN_SECRET=change-me-session-0123456789abcdef
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=
# Only when every request reaches the API through the web app or a proxy that sets X-Forwarded-For: the sign-in
# lockout then counts the browser's address instead of the proxy's.
# TRUST_PROXY=1

# Sail-issued tokens (at least 16 characters each; rotate to invalidate every device of that kind).
STATION_TOKEN_SECRET=change-me-station-0123456789abcdef
GUEST_TOKEN_SECRET=change-me-guest-0123456789abcdef
RELAY_TOKEN_SECRET=change-me-relay-0123456789abcdef
AGENT_TOKEN_SECRET=change-me-agent-0123456789abcdef

PIN_SESSION_IDLE_SECONDS=900
GUEST_APP_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
