# Copy to .env for a real database. For a zero-setup local run use `pnpm dev:local` instead.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# PostgreSQL. DATABASE_URL may go through a transaction pooler (for example PgBouncer on 6543); LISTEN_DATABASE_URL
# must be a direct session connection on 5432 (LISTEN, advisory locks, migrations). Without a pooler both are the same.
DATABASE_URL=postgres://sail:<password>@localhost:5432/sail
LISTEN_DATABASE_URL=postgres://sail:<password>@localhost:5432/sail
DB_POOL_MAX=10
TX_MAX=6
QUEUE_MAX=64

CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Back-office sign-in. By default people sign in with email and password (the local identity provider), and sessions
# are signed with SESSION_TOKEN_SECRET. Setting SUPABASE_URL (JWKS) and/or SUPABASE_JWT_SECRET switches to an
# external OIDC issuer instead.
SESSION_TOKEN_SECRET=change-me-session-0123456789abcdef
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=
# Only when every request reaches the API through the web app or a proxy that sets X-Forwarded-For: the sign-in
# lockout then counts the browser's address instead of the proxy's.
# TRUST_PROXY=1

# Sail-issued tokens (rotate to invalidate every device of that kind). These placeholders work only outside
# production: with NODE_ENV=production the API refuses any `change-me` value or a secret shorter than 32 characters.
# Generate each with `openssl rand -hex 32`.
STATION_TOKEN_SECRET=change-me-station-0123456789abcdef
GUEST_TOKEN_SECRET=change-me-guest-0123456789abcdef
RELAY_TOKEN_SECRET=change-me-relay-0123456789abcdef
AGENT_TOKEN_SECRET=change-me-agent-0123456789abcdef

PIN_SESSION_IDLE_SECONDS=900
GUEST_APP_URL=http://localhost:3001
# The back office's address, for invite and password-reset links. Required in production; unset in development,
# links open the back office they were made from.
# WEB_APP_URL=https://backoffice.example.com
