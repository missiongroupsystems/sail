# The register (Sail API). The browser never calls it directly; Next proxies /api/v1/* with the session cookie.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Only when the API uses an external identity provider (SUPABASE_URL or SUPABASE_JWT_SECRET):
# /login then signs in with Supabase email and password and sends the access token to the API.
# With the API's built-in email and password sign-in, leave both unset.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
