# The register (Sail API). The browser never calls it directly; Next proxies /api/v1/* with the session cookie.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: Supabase email + password sign-in. When both are set, /login uses Supabase and
# sends the Supabase access token to the API. Leave unset to use the development sign-in
# (POST /v1/auth/dev-token), which the API only serves outside production.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
